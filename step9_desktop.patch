diff --git a/sandbox/desktop.py b/sandbox/desktop.py
new file mode 100644
index 0000000..9379ee8
--- /dev/null
+++ b/sandbox/desktop.py
@@ -0,0 +1,145 @@
+"""A small simulated desktop: icons, windows and a taskbar.
+
+Every clickable widget is exposed as a Target, so the intent controller works on
+it unchanged. Only widgets that are actually reachable count as targets:
+the top window's controls, the taskbar, and icons not hidden behind a window.
+"""
+from __future__ import annotations
+
+from typing import Optional
+
+from sandbox.widgets import Widget, Window
+from visualization.cursor_canvas import draw_cursor, draw_polyline
+
+WINDOW_SPECS = {
+    "notepad": ("Notepad", 420, 70, 460, 300),
+    "calculator": ("Calculator", 420, 70, 300, 380),
+    "settings": ("Settings", 420, 70, 460, 300),
+}
+ICON_ORDER = [("notepad", "Notepad"), ("calculator", "Calculator"), ("settings", "Settings")]
+
+
+class Desktop:
+    TASKBAR_H = 44
+    ICON_SIZE = 64
+
+    def __init__(self, width: int = 1100, height: int = 700):
+        self.width, self.height = width, height
+        self.windows: list[Window] = []          # last item = topmost
+        self.raw_trail: list[tuple[float, float]] = []
+        self.output_trail: list[tuple[float, float]] = []
+        self.last_clicked: Optional[str] = None
+        self._font = None
+
+        # Icons sit below the diagnostics text panel for now (moves in a later step).
+        self.icons = [
+            Widget(f"icon:{key}", 24, 340 + i * 100, self.ICON_SIZE, self.ICON_SIZE, name[:3],
+                   on_click=lambda k=key: self.open_window(k))
+            for i, (key, name) in enumerate(ICON_ORDER)
+        ]
+        self.icon_names = dict(ICON_ORDER)
+        self.show_desktop_btn = Widget(
+            "taskbar:desktop", 8, height - self.TASKBAR_H + 6, 90, 32, "Desktop",
+            on_click=self.close_all)
+
+    # ---- windows -----------------------------------------------------
+    def open_window(self, key: str):
+        for win in self.windows:
+            if win.id == key:                       # already open: bring to front
+                self.windows.remove(win)
+                self.windows.append(win)
+                return
+        title, x, y, w, h = WINDOW_SPECS[key]
+        win = Window(key, title, x, y, w, h, on_close=lambda k=key: self.close_window(k))
+        self.windows.append(win)
+
+    def close_window(self, key: str):
+        self.windows = [w for w in self.windows if w.id != key]
+
+    def close_all(self):
+        self.windows.clear()
+
+    # ---- targets / hit testing --------------------------------------
+    def _icon_covered(self, icon: Widget) -> bool:
+        cx, cy = icon.center
+        return any(win.contains(cx, cy) for win in self.windows)
+
+    def _reachable(self) -> list[Widget]:
+        items: list[Widget] = []
+        if self.windows:
+            items += self.windows[-1].clickables()
+        items += [i for i in self.icons if not self._icon_covered(i)]
+        items.append(self.show_desktop_btn)
+        return items
+
+    @property
+    def targets(self):
+        return [w.to_target() for w in self._reachable()]
+
+    def _hit(self, x: float, y: float) -> Optional[Widget]:
+        for widget in self._reachable():
+            if widget.contains(x, y):
+                return widget
+        return None
+
+    def hover(self, x: float, y: float):
+        hit = self._hit(x, y)
+        for w in self._reachable():
+            w.hovered = w is hit
+        for win in self.windows[:-1]:
+            for w in win.clickables():
+                w.hovered = False
+
+    def click(self, x: float, y: float) -> Optional[str]:
+        """Click at (x, y). Returns the id of the activated widget, or None."""
+        hit = self._hit(x, y)
+        if hit is not None:
+            self.last_clicked = hit.id
+            if hit.on_click:
+                hit.on_click()
+            return hit.id
+        # Clicked the body of a lower window: bring it to front.
+        for win in reversed(self.windows[:-1]):
+            if win.contains(x, y):
+                self.windows.remove(win)
+                self.windows.append(win)
+                break
+        self.last_clicked = None
+        return None
+
+    # ---- drawing (same API as SandboxScene) -------------------------
+    def set_layout(self, layout: str):
+        """Layouts belong to the test scene; the desktop ignores them."""
+
+    def add_positions(self, raw_xy, output_xy, trail_limit: int = 120):
+        self.raw_trail.append(tuple(raw_xy))
+        self.output_trail.append(tuple(output_xy))
+        del self.raw_trail[:-trail_limit]
+        del self.output_trail[:-trail_limit]
+
+    def draw(self, surface, cursor_xy=None):
+        import pygame
+
+        if self._font is None:
+            self._font = pygame.font.Font(None, 22)
+        surface.fill((20, 24, 48))
+        pygame.draw.circle(surface, (28, 34, 70), (self.width - 150, 220), 220)   # wallpaper accent
+
+        for icon in self.icons:
+            icon.draw(surface, self._font, fill=(44, 90, 120), hover_fill=(70, 140, 180))
+            name = self.icon_names[icon.id.split(":")[1]]
+            caption = self._font.render(name, True, (225, 230, 245))
+            surface.blit(caption, caption.get_rect(midtop=(icon.x + icon.w / 2, icon.y + icon.h + 4)))
+
+        for win in self.windows:
+            win.draw(surface, self._font)
+
+        bar = pygame.Rect(0, self.height - self.TASKBAR_H, self.width, self.TASKBAR_H)
+        pygame.draw.rect(surface, (14, 16, 34), bar)
+        pygame.draw.line(surface, (90, 100, 170), bar.topleft, bar.topright)
+        self.show_desktop_btn.draw(surface, self._font)
+
+        draw_polyline(surface, self.raw_trail, (130, 110, 160), 1)
+        draw_polyline(surface, self.output_trail, (80, 220, 190), 2)
+        if cursor_xy:
+            draw_cursor(surface, cursor_xy)
diff --git a/sandbox/widgets.py b/sandbox/widgets.py
new file mode 100644
index 0000000..498dabb
--- /dev/null
+++ b/sandbox/widgets.py
@@ -0,0 +1,76 @@
+"""Basic desktop widgets. Every clickable widget can be exposed as a Target."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Callable, Optional
+
+from shared.contracts import Target
+
+
+@dataclass
+class Widget:
+    id: str
+    x: float
+    y: float
+    w: float
+    h: float
+    label: str = ""
+    on_click: Optional[Callable[[], None]] = None
+    hovered: bool = False
+
+    def contains(self, px: float, py: float) -> bool:
+        return self.x <= px <= self.x + self.w and self.y <= py <= self.y + self.h
+
+    @property
+    def center(self) -> tuple[float, float]:
+        return self.x + self.w / 2, self.y + self.h / 2
+
+    def to_target(self) -> Target:
+        cx, cy = self.center
+        return Target(self.id, cx, cy, self.w, self.h)
+
+    def draw(self, surface, font, fill=(52, 56, 90), hover_fill=(86, 96, 160)):
+        import pygame
+
+        rect = pygame.Rect(self.x, self.y, self.w, self.h)
+        pygame.draw.rect(surface, hover_fill if self.hovered else fill, rect, border_radius=6)
+        pygame.draw.rect(surface, (140, 150, 210), rect, width=1, border_radius=6)
+        if self.label:
+            text = font.render(self.label, True, (235, 238, 250))
+            surface.blit(text, text.get_rect(center=rect.center))
+
+
+class Window:
+    TITLE_H = 30
+
+    def __init__(self, id: str, title: str, x: float, y: float, w: float, h: float,
+                 on_close: Optional[Callable[[], None]] = None):
+        self.id, self.title = id, title
+        self.x, self.y, self.w, self.h = x, y, w, h
+        self.close_btn = Widget(f"{id}:close", x + w - 34, y + 3, 30, 24, "X", on_close)
+        self.widgets: list[Widget] = []   # content widgets (calculator keys, toggles...)
+
+    def contains(self, px: float, py: float) -> bool:
+        return self.x <= px <= self.x + self.w and self.y <= py <= self.y + self.h
+
+    def add_button(self, id: str, label: str, rx: float, ry: float, w: float, h: float,
+                   on_click: Optional[Callable[[], None]] = None) -> Widget:
+        """Add a button at a position RELATIVE to the window's content area."""
+        btn = Widget(f"{self.id}:{id}", self.x + rx, self.y + self.TITLE_H + ry, w, h, label, on_click)
+        self.widgets.append(btn)
+        return btn
+
+    def clickables(self) -> list[Widget]:
+        return [self.close_btn, *self.widgets]
+
+    def draw(self, surface, font):
+        import pygame
+
+        body = pygame.Rect(self.x, self.y, self.w, self.h)
+        pygame.draw.rect(surface, (30, 32, 58), body, border_radius=8)
+        pygame.draw.rect(surface, (110, 120, 190), body, width=2, border_radius=8)
+        bar = pygame.Rect(self.x, self.y, self.w, self.TITLE_H)
+        pygame.draw.rect(surface, (64, 72, 140), bar, border_top_left_radius=8, border_top_right_radius=8)
+        surface.blit(font.render(self.title, True, (240, 242, 255)), (self.x + 10, self.y + 7))
+        for widget in self.clickables():
+            widget.draw(surface, font)
diff --git a/tests/test_desktop.py b/tests/test_desktop.py
new file mode 100644
index 0000000..bab57ba
--- /dev/null
+++ b/tests/test_desktop.py
@@ -0,0 +1,38 @@
+from sandbox.desktop import Desktop
+
+
+def test_icons_are_targets_and_open_windows():
+    d = Desktop()
+    assert {t.id for t in d.targets} >= {"icon:notepad", "icon:calculator", "icon:settings", "taskbar:desktop"}
+    icon = d.icons[0]
+    assert d.click(*icon.center) == "icon:notepad"
+    assert [w.id for w in d.windows] == ["notepad"]
+
+
+def test_window_close_button_and_show_desktop():
+    d = Desktop()
+    d.open_window("calculator")
+    close = d.windows[-1].close_btn
+    assert d.click(*close.center) == "calculator:close"
+    assert d.windows == []
+    d.open_window("notepad")
+    d.open_window("settings")
+    d.click(*d.show_desktop_btn.center)
+    assert d.windows == []
+
+
+def test_covered_icon_is_not_a_target():
+    d = Desktop()
+    d.open_window("notepad")          # window at x=420.., icons at x=24 stay visible
+    assert "icon:notepad" in {t.id for t in d.targets}
+    win = d.windows[-1]               # slide the window over the icons
+    win.x, win.y, win.w, win.h = 0, 300, 400, 400
+    assert "icon:notepad" not in {t.id for t in d.targets}
+
+
+def test_only_top_window_controls_are_targets():
+    d = Desktop()
+    d.open_window("notepad")
+    d.open_window("settings")
+    ids = {t.id for t in d.targets}
+    assert "settings:close" in ids and "notepad:close" not in ids
